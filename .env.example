# ORBIT environment configuration
# Copy to .env.local for local development. Every value below is optional —
# ORBIT's core tools (Command Center, search, converters, formatters, PDF
# Intelligence's local extraction) work with zero configuration. Missing
# values simply disable the dependent feature; nothing is faked at runtime.

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (workspace sync — optional) ---------------------------------
# Leave unset to run ORBIT in local-only mode (history/favorites persist to
# the browser via localStorage instead of a database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (grammar/rewrite/summarize/PDF Q&A/ORBIT Assistant — optional) ---
# Set exactly one. Gemini is preferred when set (ORBIT's initial provider),
# then Anthropic, then OpenAI. If none are set, AI features show "not
# configured" instead of fabricating output. Never NEXT_PUBLIC_* — these
# are read only by server code (see src/config/env.ts's serverSchema).
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Image-generation provider (optional) ---------------------------------
OPENAI_IMAGE_API_KEY=
STABILITY_API_KEY=

# --- Web search provider (Search page's Web results — optional) -----------
# Set exactly one. ORBIT's own tool search always works regardless.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# --- Zero Degree app registry (optional) -----------------------------------
# URLs for sibling Zero Degree products. Unset entries render as
# "not connected" in the app switcher rather than a broken link.
NEXT_PUBLIC_ZHUB_URL=
NEXT_PUBLIC_LOOP_URL=
NEXT_PUBLIC_CIVI_URL=
